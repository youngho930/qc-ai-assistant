# 이 파일을 복사해 .env 로 만들고 실제 값을 채워 사용하세요.
# .env 는 .gitignore 에 포함되어 저장소에 올라가지 않습니다.

# Google AI Studio 에서 발급받은 키
GEMINI_API_KEY=

# 모델은 무료 티어에서 사용 가능한 것으로 지정합니다.
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# (선택) 기본 모델이 붐벼서 재시도 후에도 실패할 때 한 번 더 시도할 예비 모델.
# 비워두면 예비 모델 없이 안내 문구만 보여줍니다.
GEMINI_FALLBACK_MODEL=

# 관리자 비밀번호의 SHA-256 해시.
# python make_password.py 를 실행해 생성한 값을 넣으세요.
# 비워두면 로그인이 비활성화되고 품목명이 계속 가려집니다.
ADMIN_PASSWORD_HASH=
